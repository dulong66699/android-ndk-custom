zlib: TARGET_OS_MAC is set on every Apple target and defines fdopen to NULL,
which breaks current macOS SDK headers. zlib 1.2.12 dropped the check.

--- a/zlib/zutil.h
+++ b/zlib/zutil.h
@@ -118,7 +118,7 @@
 #  endif
 #endif
 
-#if defined(MACOS) || defined(TARGET_OS_MAC)
+#if defined(MACOS)
 #  define OS_CODE  0x07
 #  ifndef Z_SOLO
 #    if defined(__MWERKS__) && __dest_os != __be_os && __dest_os != __win32_os
