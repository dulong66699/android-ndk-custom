USE_PYFFI_DELTA selects Python's old bundled x86 libffi_msvc, keyed on the
system libffi not defining X86_ANY. Off x86 (aarch64 mingw) there is no
such copy; ffi_call returns void and the delta assignment fails to compile.

--- a/Modules/_ctypes/callproc.c
+++ b/Modules/_ctypes/callproc.c
@@ -772,7 +772,7 @@
 
 #undef USE_PYFFI_DELTA
 #ifdef MS_WIN32
-#ifdef X86_ANY
+#if defined(X86_ANY) || !(defined(__i386__) || defined(__x86_64__))
 /* NOTE:
  * - Standard library does not calculate stack pointer difference
  *   unlike python specific for MSVC source.
