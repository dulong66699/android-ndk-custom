Python 2 only cross-builds for Linux and Cygwin. Map the BSDs and Darwin to
their uname -s names so the platform-specific configure paths apply, and on
Darwin take the architecture from the host triple rather than /usr/bin/arch.

--- a/configure
+++ b/configure
@@ -3287,6 +3287,18 @@
 	*-*-cygwin*)
 		ac_sys_system=Cygwin
 		;;
+	*-freebsd*)
+		ac_sys_system=FreeBSD
+		;;
+	*-netbsd*)
+		ac_sys_system=NetBSD
+		;;
+	*-openbsd*)
+		ac_sys_system=OpenBSD
+		;;
+	*-darwin*)
+		ac_sys_system=Darwin
+		;;
 	*)
 		# for now, limit cross builds to known configurations
 		MACHDEP="unknown"
@@ -3333,6 +3345,9 @@
 	*-*-cygwin*)
 		_host_cpu=
 		;;
+	*-freebsd*|*-netbsd*|*-openbsd*|*-darwin*)
+		_host_cpu=$host_cpu
+		;;
 	*)
 		# for now, limit cross builds to known configurations
 		MACHDEP="unknown"
@@ -8454,7 +8469,10 @@
 fi
 
 
-    if test "${ac_osx_32bit}" = "yes"; then
+    if test "$cross_compiling" = yes; then
+    	# only feeds LIBTOOL_CRUFT (framework builds); don't ask this machine
+    	MACOSX_DEFAULT_ARCH="$host_cpu"
+    elif test "${ac_osx_32bit}" = "yes"; then
     	case `/usr/bin/arch` in
     	i386)
     		MACOSX_DEFAULT_ARCH="i386"
