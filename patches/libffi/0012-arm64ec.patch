diff --git a/src/dlmalloc.c b/src/dlmalloc.c
index 93e8196..5a988cc 100644
--- a/src/dlmalloc.c
+++ b/src/dlmalloc.c
@@ -1725,15 +1725,43 @@ static int os2munmap(void* ptr, size_t size) {
 /* Win32 MMAP via VirtualAlloc */
 /* libffi: plain static (not FORCEINLINE) -- mingw's <windows.h> defines
    FORCEINLINE with an 'extern' storage class, which clashes with 'static'.  */
+#ifdef __arm64ec__
+/* libffi: closure trampolines are Arm64 code.  An Arm64EC process runs
+   memory that is not marked as EC code under x64 emulation, so allocate
+   it with VirtualAlloc2 and MEM_EXTENDED_PARAMETER_EC_CODE.  */
+typedef PVOID (WINAPI *ffi_VirtualAlloc2_t) (HANDLE, PVOID, SIZE_T, ULONG,
+                                             ULONG, void *, ULONG);
+static void* win32_ec_alloc(size_t size, DWORD type) {
+  static ffi_VirtualAlloc2_t va2;
+  struct { DWORD64 Type_Reserved; DWORD64 ULong64; } param;
+  if (!va2)
+    va2 = (ffi_VirtualAlloc2_t) (void (*) (void))
+      GetProcAddress (GetModuleHandleW (L"kernelbase.dll"), "VirtualAlloc2");
+  if (!va2)
+    return 0;
+  param.Type_Reserved = 5; /* MemExtendedParameterAttributeFlags */
+  param.ULong64 = 0x1;     /* MEM_EXTENDED_PARAMETER_EC_CODE */
+  return va2 (0, 0, size, type, PAGE_EXECUTE_READWRITE, &param, 1);
+}
+#endif
+
 static void* win32mmap(size_t size) {
+#ifdef __arm64ec__
+  void* ptr = win32_ec_alloc(size, MEM_RESERVE|MEM_COMMIT);
+#else
   void* ptr = VirtualAlloc(0, size, MEM_RESERVE|MEM_COMMIT, PAGE_EXECUTE_READWRITE);
+#endif
   return (ptr != 0)? ptr: MFAIL;
 }
 
 /* For direct MMAP, use MEM_TOP_DOWN to minimize interference */
 static void* win32direct_mmap(size_t size) {
+#ifdef __arm64ec__
+  void* ptr = win32_ec_alloc(size, MEM_RESERVE|MEM_COMMIT|MEM_TOP_DOWN);
+#else
   void* ptr = VirtualAlloc(0, size, MEM_RESERVE|MEM_COMMIT|MEM_TOP_DOWN,
                            PAGE_EXECUTE_READWRITE);
+#endif
   return (ptr != 0)? ptr: MFAIL;
 }
 
