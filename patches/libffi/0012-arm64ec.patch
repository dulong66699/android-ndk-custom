 {
   ffi_status status = ffi_prep_cif_machdep (cif);
   cif->flags |= AARCH64_FLAG_VARARG;
+#ifdef __arm64ec__
+  /* x64 rules: one 8-byte slot per argument past the first four.  */
+  if (ntotalargs > 4 && cif->bytes < FFI_ALIGN ((ntotalargs - 4) * 8, 16))
