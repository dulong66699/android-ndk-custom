   rvalue = (rsize ? (void*)((uintptr_t)frame + 40) : orig_rvalue);
 
   arg_init (&state, stack_bytes);
+#ifdef __arm64ec__
+  if (isvariadic)
+    {
+      /* Arm64EC variadic calls follow the x64 rules (clang's
+	 classifyArgForArm64ECVarArg, LLVM's CC_AArch64_Arm64EC_VarArg):
+	 each argument takes one 8-byte slot, the first four in x0-x3 and
+	 the rest on the stack, floating-point values included; aggregates
+	 that are not 1, 2, 4 or 8 bytes are passed by reference.  x4
+	 points at the stack arguments and x5 holds their size.  */
+      size_t nsaa = 0;
+      for (i = 0, nargs = cif->nargs; i < nargs; i++)
+	{
+	  ffi_type *ty = cif->arg_types[i];
+	  size_t s = ty->size;
+	  UINT64 slot = 0;
+
+	  switch (ty->type)
+	    {
+	    case FFI_TYPE_FLOAT:
+	    case FFI_TYPE_DOUBLE:
+	    case FFI_TYPE_LONGDOUBLE:
+	    case FFI_TYPE_STRUCT:
+	    case FFI_TYPE_COMPLEX:
+	      if (s == 1 || s == 2 || s == 4 || s == 8)
+		memcpy (&slot, avalue[i], s);
+	      else
+		{
+		  void *copy = alloca (s);
+		  memcpy (copy, avalue[i], s);
+		  slot = (uintptr_t) copy;
+		}
+	      break;
+	    default:
+	      slot = extend_integer_type (avalue[i], ty->type);
+	      break;
+	    }
+	  if (i < 4)
+	    context->x[i] = slot;
+	  else
+	    {
+	      memcpy ((char *) stack + nsaa, &slot, 8);
+	      nsaa += 8;
+	    }
+	}
+      context->x[4] = (uintptr_t) stack;
+      context->x[5] = nsaa;
+      goto do_call;
+    }
+#endif
   for (i = 0, nargs = cif->nargs; i < nargs; i++)
     {
       ffi_type *ty = cif->arg_types[i];
@@ -993,6 +1047,9 @@ ffi_call_int (ffi_cif *cif, void (*fn)(void), void *orig_rvalue,
 #endif
     }
 
+#ifdef __arm64ec__
+ do_call:
+#endif
   ffi_call_SYSV (context, frame, fn, rvalue, flags, closure);
 
   if (flags & AARCH64_RET_NEED_COPY)
