+#ifdef __ARMEB__
+/* Big-endian: an integer narrower than a word occupies the high-address
+   end of its 4-byte register or stack slot.  */
+static void
+be_small_int_args (ffi_cif *cif, void **avalue)
+{
+  unsigned i;
+  for (i = 0; i < cif->nargs; i++)
+    switch (cif->arg_types[i]->type)
+      {
+      case FFI_TYPE_SINT8:
+      case FFI_TYPE_UINT8:
+      case FFI_TYPE_SINT16:
+      case FFI_TYPE_UINT16:
+	avalue[i] = (char *) avalue[i] + 4 - cif->arg_types[i]->size;
+	break;
+      }
+}
+#endif
+
 static void *
 ffi_prep_incoming_args_SYSV (ffi_cif *cif, void *rvalue,
 			     char *argp, void **avalue)
@@ -503,6 +523,9 @@ ffi_prep_incoming_args_SYSV (ffi_cif *cif, void *rvalue,
       argp += z;
     }
 
+#ifdef __ARMEB__
+  be_small_int_args (cif, avalue);
+#endif
   return rvalue;
 }
 
@@ -584,6 +607,9 @@ ffi_prep_incoming_args_VFP (ffi_cif *cif, void *rvalue, char *stack,
       argp += z;
     }
 
