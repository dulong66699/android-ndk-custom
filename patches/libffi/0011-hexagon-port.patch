+   EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
+   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+   NONINFRINGEMENT.  IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT
+   HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY,
+   WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+   OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+   DEALINGS IN THE SOFTWARE.
+   ----------------------------------------------------------------------- */
+
+#include <ffi.h>
+#include <ffi_common.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "internal.h"
+
+/* This follows clang's lowering (clang/lib/CodeGen/Targets/Hexagon.cpp)
+   and LLVM's CC_Hexagon, musl flavour:
+
+   - Scalars take r0-r5 in order.  A 64-bit one (long long, double) takes
+     the next even pair, skipping an odd register; once none is left it
+     goes on the stack, and so does everything after it.
+   - Structs of up to 8 bytes are passed as a 32- or 64-bit integer when
+     clang's own count of free registers says they fit, or when they are
+     no larger than their alignment; otherwise, like every larger struct,
+     they are copied onto the stack in a slot of at least 8 bytes.  Clang's
+     count starts at six and ignores the struct-return pointer, which LLVM
+     passes in r0.
+   - Returns come back in r0 or r1:0; structs larger than 8 bytes are
+     returned in memory whose address is passed in r0.
+   - Variadic arguments follow the same rules.  */
+
+struct arg_state
+{
+  unsigned ngrn;	/* next register LLVM allocates */
+  unsigned regs_left;	/* clang's count of free registers */
+  size_t nsaa;		/* next stack offset */
+};
+
+/* clang's HexagonAdjustRegsLeft.  */
+static int
+adjust_regs_left (struct arg_state *st, size_t size)
+{
+  if (st->regs_left == 0)
+    return 0;
+  if (size <= 4)
+    {
+      st->regs_left--;
+      return 1;
+    }
+  if (2 <= (st->regs_left & ~1U))
+    {
+      st->regs_left = (st->regs_left & ~1U) - 2;
+      return 1;
+    }
+  if (st->regs_left == 1)
+    st->regs_left = 0;
+  return 0;
+}
+
+static int
+place_int (struct arg_state *st, size_t size, size_t *off)
+{
+  if (size > 4)
+    {
+      st->ngrn = FFI_ALIGN (st->ngrn, 2);
+      if (st->ngrn + 2 <= HEXAGON_NARGREG)
+	{
+	  st->ngrn += 2;
+	  return st->ngrn - 2;
+	}
+      st->ngrn = HEXAGON_NARGREG;
+      st->nsaa = FFI_ALIGN (st->nsaa, 8);
+      *off = st->nsaa;
+      st->nsaa += 8;
+      return -1;
+    }
+  if (st->ngrn < HEXAGON_NARGREG)
+    return st->ngrn++;
+  st->nsaa = FFI_ALIGN (st->nsaa, 4);
+  *off = st->nsaa;
+  st->nsaa += 4;
+  return -1;
+}
+
+/* Returns the first register of ARG, or -1 when it is passed on the stack
+   at offset *OFF.  */
+static int
+place_arg (ffi_type *arg, struct arg_state *st, size_t *off)
+{
+  size_t z = arg->size;
+
+  if (arg->type == FFI_TYPE_STRUCT || arg->type == FFI_TYPE_COMPLEX)
+    {
+      if (z <= 8)
+	{
+	  size_t align = adjust_regs_left (st, z) ? (z <= 4 ? 4 : 8)
+						   : arg->alignment;
+	  if (z <= align)
+	    return place_int (st, z, off);
+	}
+      st->nsaa = FFI_ALIGN (st->nsaa, arg->alignment);
+      *off = st->nsaa;
+      st->nsaa += z < 8 ? 8 : z;
+      return -1;
+    }
+
+  adjust_regs_left (st, z);
+  return place_int (st, z, off);
+}
+
+ffi_status FFI_HIDDEN
+ffi_prep_cif_machdep (ffi_cif *cif)
+{
+  struct arg_state st = { 0, HEXAGON_NARGREG, 0 };
+  unsigned i;
+  size_t off;
+
+  if (cif->rtype->type == FFI_TYPE_VOID)
+    cif->flags = HEXAGON_RET_VOID;
+  else if ((cif->rtype->type == FFI_TYPE_STRUCT
+	    || cif->rtype->type == FFI_TYPE_COMPLEX)
+	   && cif->rtype->size > 8)
+    {
+      cif->flags = HEXAGON_RET_SRET;
+      st.ngrn = 1;
+    }
+  else
+    cif->flags = HEXAGON_RET_VALUE;
+
+  for (i = 0; i < cif->nargs; i++)
+    place_arg (cif->arg_types[i], &st, &off);
+
+  cif->bytes = FFI_ALIGN (st.nsaa, 8);
+  return FFI_OK;
+}
+
+/* Stores VALUE of type T at DEST, widening sub-word integers to a word.  */
+static void
+put_arg (ffi_type *t, void *value, void *dest)
+{
+  switch (t->type)
+    {
+    case FFI_TYPE_SINT8:
+      *(SINT32 *) dest = *(SINT8 *) value;
+      break;
+    case FFI_TYPE_UINT8:
+      *(UINT32 *) dest = *(UINT8 *) value;
+      break;
+    case FFI_TYPE_SINT16:
+      *(SINT32 *) dest = *(SINT16 *) value;
+      break;
+    case FFI_TYPE_UINT16:
+      *(UINT32 *) dest = *(UINT16 *) value;
+      break;
+    default:
+      memcpy (dest, value, t->size);
+      break;
+    }
+}
+
+extern void ffi_call_hexagon (UINT64 *regs, void *stack, size_t bytes,
+			      void (*fn) (void), UINT64 *ret) FFI_HIDDEN;
+
+void
+ffi_call (ffi_cif *cif, void (*fn) (void), void *rvalue, void **avalue)
+{
+  UINT64 regs[HEXAGON_NARGREG / 2] = { 0 };
+  UINT64 ret = 0;
+  char *stack = alloca (cif->bytes);
+  struct arg_state st = { 0, HEXAGON_NARGREG, 0 };
+  unsigned i;
+  size_t off;
+
+  if (cif->flags == HEXAGON_RET_SRET)
+    {
+      if (rvalue == NULL)
+	rvalue = alloca (cif->rtype->size);
+      ((UINT32 *) regs)[st.ngrn++] = (UINT32) (uintptr_t) rvalue;
+    }
+
+  for (i = 0; i < cif->nargs; i++)
+    {
+      ffi_type *t = cif->arg_types[i];
+      int r = place_arg (t, &st, &off);
+      put_arg (t, avalue[i], r >= 0 ? (char *) regs + r * 4 : stack + off);
+    }
+
+  ffi_call_hexagon (regs, stack, cif->bytes, fn, &ret);
+
+  if (cif->flags != HEXAGON_RET_VALUE || rvalue == NULL)
+    return;
+  switch (cif->rtype->type)
+    {
+    case FFI_TYPE_SINT8:
+      *(ffi_sarg *) rvalue = (SINT8) ret;
+      break;
+    case FFI_TYPE_UINT8:
+      *(ffi_arg *) rvalue = (UINT8) ret;
+      break;
+    case FFI_TYPE_SINT16:
+      *(ffi_sarg *) rvalue = (SINT16) ret;
+      break;
+    case FFI_TYPE_UINT16:
+      *(ffi_arg *) rvalue = (UINT16) ret;
+      break;
+    default:
+      memcpy (rvalue, &ret, cif->rtype->size);
+      break;
+    }
+}
+
+#if FFI_CLOSURES
+
+extern const char ffi_hexagon_trampoline[] FFI_HIDDEN;
+extern void ffi_closure_hexagon (void) FFI_HIDDEN;
+
+static void
+flush_icache (char *start, size_t size)
+{
+  uintptr_t p, end = (uintptr_t) start + size;
+
+  for (p = (uintptr_t) start & ~(uintptr_t) 31; p < end; p += 32)
+    __asm__ volatile ("dccleana(%0)" : : "r" (p) : "memory");
+  for (p = (uintptr_t) start & ~(uintptr_t) 31; p < end; p += 32)
+    __asm__ volatile ("icinva(%0)" : : "r" (p) : "memory");
+  __asm__ volatile ("isync" : : : "memory");
+}
+
+ffi_status
+ffi_prep_closure_loc (ffi_closure *closure, ffi_cif *cif,
+		      void (*fun) (ffi_cif *, void *, void **, void *),
+		      void *user_data, void *codeloc)
+{
+  char *tramp = closure->tramp;
+
+  if (cif->abi != FFI_SYSV)
+    return FFI_BAD_ABI;
+
+  memcpy (tramp, ffi_hexagon_trampoline, 16);
+  ((void **) tramp)[4] = closure;
+  ((void **) tramp)[5] = (void *) ffi_closure_hexagon;
+
+  closure->cif = cif;
+  closure->fun = fun;
+  closure->user_data = user_data;
+
+  flush_icache (codeloc, FFI_TRAMPOLINE_SIZE);
+  return FFI_OK;
+}
+
+/* Called from ffi_closure_hexagon with the argument registers saved in
+   REGS, the caller's stack arguments at STACK, and RET to be loaded into
+   r1:0 on return.  */
+void FFI_HIDDEN
+ffi_closure_hexagon_inner (ffi_closure *closure, UINT32 *regs, char *stack,
+			   UINT64 *ret)
+{
+  ffi_cif *cif = closure->cif;
+  void **avalue = alloca (cif->nargs * sizeof (void *));
+  void *rvalue = ret;
+  struct arg_state st = { 0, HEXAGON_NARGREG, 0 };
+  unsigned i;
+  size_t off;
+
+  if (cif->flags == HEXAGON_RET_SRET)
+    {
+      rvalue = (void *) (uintptr_t) regs[0];
+      st.ngrn = 1;
+    }
+
+  for (i = 0; i < cif->nargs; i++)
+    {
+      int r = place_arg (cif->arg_types[i], &st, &off);
+      avalue[i] = r >= 0 ? (void *) &regs[r] : (void *) (stack + off);
+    }
+
+  closure->fun (cif, rvalue, avalue, closure->user_data);
+
+  if (cif->flags == HEXAGON_RET_SRET)
+    *(UINT32 *) ret = (UINT32) (uintptr_t) rvalue;
+}
+
+#endif
