+#define LIBFFI_ASM
+#include <fficonfig.h>
+#include <ffi.h>
+
+	.text
+
+/* void ffi_call_hexagon (UINT64 *regs, void *stack, size_t bytes,
+			  void (*fn) (void), UINT64 *ret)
+
+   BYTES is a multiple of 8.  */
+	.p2align 4
+	.globl	ffi_call_hexagon
+	.hidden	ffi_call_hexagon
+	.type	ffi_call_hexagon, @function
+ffi_call_hexagon:
+	.cfi_startproc
+	{ allocframe(#8) }
+	.cfi_def_cfa r30, 8
+	.cfi_offset r31, -4
+	.cfi_offset r30, -8
+	{ memd(r29+#0) = r17:16 }
+	.cfi_offset r16, -16
+	.cfi_offset r17, -12
+	{ r16 = r4
+	  r17 = r0 }
+	{ r29 = sub(r29,r2)
+	  r6 = lsr(r2,#2) }
+	{ r5 = r29
+	  p0 = cmp.eq(r6,#0)
+	  if (p0.new) jump:nt 2f }
+1:	{ r7 = memw(r1++#4) }
+	{ memw(r5++#4) = r7
+	  r6 = add(r6,#-1) }
+	{ p0 = cmp.eq(r6,#0)
+	  if (!p0.new) jump:t 1b }
+2:	{ r28 = r3 }
+	{ r1:0 = memd(r17+#0) }
+	{ r3:2 = memd(r17+#8) }
+	{ r5:4 = memd(r17+#16) }
+	{ callr r28 }
+	{ memd(r16+#0) = r1:0 }
+	{ r17:16 = memd(r30+#-8) }
+	{ dealloc_return }
+	.cfi_endproc
+	.size	ffi_call_hexagon, .-ffi_call_hexagon
+
+#if FFI_CLOSURES
+/* Copied into each closure: loads the closure and the entry point stored
+   right after these 16 bytes, closure in r28.  */
+	.p2align 2
+	.globl	ffi_hexagon_trampoline
+	.hidden	ffi_hexagon_trampoline
+	.type	ffi_hexagon_trampoline, @object
+ffi_hexagon_trampoline:
+	{ r28 = add(pc,#16) }
+	{ r6 = memw(r28+#4)
+	  r28 = memw(r28+#0) }
+	{ jumpr r6 }
+	.size	ffi_hexagon_trampoline, .-ffi_hexagon_trampoline
+
+/* Entered from a trampoline with the closure in r28.  */
+	.p2align 4
+	.globl	ffi_closure_hexagon
+	.hidden	ffi_closure_hexagon
+	.type	ffi_closure_hexagon, @function
+ffi_closure_hexagon:
+	.cfi_startproc
+	{ allocframe(#32) }
+	.cfi_def_cfa r30, 8
+	.cfi_offset r31, -4
+	.cfi_offset r30, -8
+	{ memd(r29+#0) = r1:0 }
+	{ memd(r29+#8) = r3:2 }
+	{ memd(r29+#16) = r5:4 }
+	{ r0 = r28
+	  r1 = r29
+	  r2 = add(r30,#8)
+	  r3 = add(r29,#24) }
+	{ call ffi_closure_hexagon_inner }
+	{ r1:0 = memd(r29+#24) }
+	{ dealloc_return }
+	.cfi_endproc
+	.size	ffi_closure_hexagon, .-ffi_closure_hexagon
+#endif
+
+#if defined __ELF__ && defined __linux__
+	.section	.note.GNU-stack,"",@progbits
+#endif
