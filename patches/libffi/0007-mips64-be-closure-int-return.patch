diff --git a/src/mips/n32.S b/src/mips/n32.S
index 40a4a46..89760a6 100644
--- a/src/mips/n32.S
+++ b/src/mips/n32.S
@@ -520,6 +520,17 @@ epilogue:
 
 #define V1_OFF2		(3  * FFI_SIZEOF_ARG)
 #define V0_OFF2		(2  * FFI_SIZEOF_ARG)
+/* Closures return small integers widened to an ffi_arg; on big-endian
+   the narrower value is at the high-address end of it.  */
+#ifdef __MIPSEB__
+#define V0_W_OFF2	(V0_OFF2 + 4)
+#define V0_H_OFF2	(V0_OFF2 + 6)
+#define V0_B_OFF2	(V0_OFF2 + 7)
+#else
+#define V0_W_OFF2	V0_OFF2
+#define V0_H_OFF2	V0_OFF2
+#define V0_B_OFF2	V0_OFF2
+#endif
 
 #define RA_OFF2		(1  * FFI_SIZEOF_ARG)
 #define GP_OFF2		(0  * FFI_SIZEOF_ARG)
@@ -628,27 +639,27 @@ cls_retuint64:
 
 cls_retsint32:
 	bne     v0, FFI_TYPE_SINT32, cls_retsint16
-	lw	v0, V0_OFF2($sp)
+	lw	v0, V0_W_OFF2($sp)
 	b	cls_epilogue
 
 cls_retsint16:
 	bne     v0, FFI_TYPE_SINT16, cls_retuint16
-	lh	v0, V0_OFF2($sp)
+	lh	v0, V0_H_OFF2($sp)
 	b	cls_epilogue
 
 cls_retuint16:
 	bne     v0, FFI_TYPE_UINT16, cls_retsint8
-	lhu	v0, V0_OFF2($sp)
+	lhu	v0, V0_H_OFF2($sp)
 	b	cls_epilogue
 
 cls_retsint8:
 	bne     v0, FFI_TYPE_SINT8, cls_retuint8
-	lb	v0, V0_OFF2($sp)
+	lb	v0, V0_B_OFF2($sp)
 	b	cls_epilogue
 
 cls_retuint8:
 	bne     v0, FFI_TYPE_UINT8, cls_retfloat
-	lbu	v0, V0_OFF2($sp)
+	lbu	v0, V0_B_OFF2($sp)
 	b	cls_epilogue
 
 cls_retfloat:
